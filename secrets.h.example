// secrets.h.example - template for the git-ignored secrets.h
//
// Setup: copy this file to secrets.h (same folder as the .ino) and fill in
// your real values. secrets.h is listed in .gitignore and must never be committed.
#ifndef SECRETS_H
#define SECRETS_H

#define SECRET_WIFI_SSID     "your-wifi-ssid"
#define SECRET_WIFI_PASSWORD "your-wifi-password"
#define SECRET_OTA_HOSTNAME  "SumpMonitor"        // Name shown in Arduino IDE / mDNS
#define SECRET_OTA_PASSWORD  "your-ota-password"  // Password for OTA updates

#endif  // SECRETS_H
