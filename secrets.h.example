// secrets.h.example - template for the git-ignored secrets.h
//
// Setup: copy this file to secrets.h (same folder as the .ino) and fill in
// your real values. secrets.h is listed in .gitignore and must never be committed.
#ifndef SECRETS_H
#define SECRETS_H

#define SECRET_WIFI_SSID     "your-wifi-ssid"
#define SECRET_WIFI_PASSWORD "your-wifi-password"
#define SECRET_OTA_HOSTNAME  "SumpMonitor"        // Name shown in Arduino IDE / mDNS
#define SECRET_OTA_PASSWORD  "your-ota-password"  // Password for OTA updates

// --- MQTT / Home Assistant (firmware 2.0+) - ALL OPTIONAL ---------------------------------------------
// The defaults built into SumpMqtt.ino already match the house broker, so an existing secrets.h keeps working
// without any of these lines. Uncomment only to override.
// #define SECRET_MQTT_HOST "192.168.1.12"   // broker IP address (use the IP, not a .local name)
// #define SECRET_MQTT_PORT 1883
// #define SECRET_MQTT_USER ""               // leave empty for an anonymous broker
// #define SECRET_MQTT_PASS ""

#endif  // SECRETS_H
